# Build environment: recreate with  py -3.11 -m venv venv  +  pip install -r requirements.txt
venv/

# Build output and runtime scratch (recreated automatically)
build/
dist/
_local_sandbox/
logs/
__pycache__/
*.pyc
*.tmp
_verify/

# Training samples are crops of real documents: may be sensitive. Never commit.
training_data/

# Scanner + Trainer package: rebuilt by build.ps1; not committed to save Git LFS storage (about 120 MB per build).
# The shareable scanner-only package, AcronymHunter_Portable.zip, IS committed.
AcronymHunter_WithTrainer.zip

# Project files hold term lists and history for real document folders: keep them out of the repo.
*.ahproj
*.ahproj.lock
*.ahproj.tmp

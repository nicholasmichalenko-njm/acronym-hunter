# Build environment: recreate with  py -3.11 -m venv venv  +  pip install -r requirements.txt
venv/

# Build output and runtime scratch (recreated automatically)
build/
dist/
_local_sandbox/
logs/
__pycache__/
*.pyc
*.tmp
_verify/

# Training samples are crops of real documents: may be sensitive. Never commit.
training_data/

# Scanner + Trainer package: rebuilt by build.ps1; not committed to save Git LFS storage (about 120 MB per build).
# The shareable scanner-only package, AcronymHunter_Portable.zip, IS committed.
AcronymHunter_WithTrainer.zip

# Project files hold term lists and history for real document folders: keep them out of the repo.
*.ahproj
*.ahproj.lock
*.ahproj.tmp
_gt_*.txt

# ---- Data boundary (see base\README.txt) ----
# Working knowledge: real terms, OCR fixes, ignore list, trained models, backups. NEVER committed.
# Only base\ (generic starter data) is committed and packaged for GitHub.
/acronym_database.csv
/config/
*Knowledge*.zip
# Built packages: published as GitHub Release files, never committed
*.zip
internal_builds/
# Training Kit build output (large; rebuilt by build_training_kit.ps1)
/training_kit/
/kit_build/

# Third-party engine binaries, fetched by tools\fetch_tesseract.ps1 (pinned SHA-256)
/vendor/

# math reader add-on build (2.2.0)
/venv_math/
/dist_math/
/build_math/
/Claude outputs/
feedback/reports/
*_SBOM.cdx.json
# 2.76.0: update packs are release files; the publisher's signing key never leaves the build PC
*.skupdate
*.skupdate.part
*signing_key*
